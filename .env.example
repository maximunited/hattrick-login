HATTRICK_USERNAME=your-hattrick-username
HATTRICK_PASSWORD=your-hattrick-password

# Optional: used with --fetch finances
# HATTRICK_TEAM_ID=1844625

# Optional: override Chrome profile + cookie snapshot directory
# HATTRICK_SESSION_DIR=

# hassvm: native Chromium path used by deploy/hassvm-run.sh
# HATTRICK_CHROME_BINARY=/usr/bin/chromium-browser

# Optional: force Docker keepalive instead of native xvfb headless
# HATTRICK_USE_DOCKER=1

# Optional: ntfy.sh notifications on keepalive success/failure
# HATTRICK_NTFY_TOPIC=your-private-topic
# HATTRICK_NTFY_SERVER=https://ntfy.sh
# HATTRICK_NTFY_TOKEN=
